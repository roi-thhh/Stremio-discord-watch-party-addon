# Discord Application credentials (from https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret

# Port for the Activity server (single port for UI, API, WebSocket, and Stream Proxy)
PORT=3000

# Local Stremio streaming server URL (stremio-runtime.exe / server.js)
STREMIO_SERVER_URL=http://127.0.0.1:11470
